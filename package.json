{
  "name": "grok-desktop-community",
  "version": "0.1.0-beta.1",
  "description": "An independent community desktop client for Grok Build",
  "main": "electron/main.mjs",
  "type": "module",
  "author": "goodcantor and contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/goodcantor/grok-desktop-community.git"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "preview": "npm run build && electron .",
    "pack": "npm run build && node scripts/package.mjs --dir",
    "dist": "npm run build && node scripts/package.mjs",
    "dist:win": "npm run build && node scripts/package.mjs --win",
    "dist:mac": "npm run build && node scripts/package.mjs --mac",
    "dist:linux": "npm run build && node scripts/package.mjs --linux",
    "test": "node --test test/**/*.test.mjs",
    "test:acp": "node --test test/acp-rpc.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:native": "node scripts/harness-native-smoke.mjs",
    "test:package": "node scripts/community-package-smoke.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "dist:preview": "npm run build && node scripts/package-preview.mjs",
    "test:ui": "node scripts/ui-layout-smoke.mjs && node scripts/ui-progress-smoke.mjs && node scripts/ui-scroll-smoke.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.19",
    "@radix-ui/react-collapsible": "1.2.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "1.57.0",
    "minisearch": "7.2.0",
    "node-pty": "1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "10.0.6",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "6.4.4",
    "wait-on": "^8.0.3",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "io.github.goodcantor.grokdesktopcommunity",
    "productName": "Grok Desktop Community",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "PRIVACY.md"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GrokDesktopCommunity-${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "artifactName": "GrokDesktopCommunity-${version}-macOS-${arch}.${ext}",
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "dmg": {
      "writeUpdateInfo": false,
      "sign": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "GrokDesktopCommunity-${version}-Linux-x64.${ext}",
      "maintainer": "goodcantor <57045864+goodcantor@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "goodcantor",
        "repo": "grok-desktop-community",
        "releaseType": "draft"
      }
    ]
  },
  "homepage": "https://github.com/goodcantor/grok-desktop-community#readme",
  "bugs": {
    "url": "https://github.com/goodcantor/grok-desktop-community/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "private": true,
  "desktopName": "io.github.goodcantor.grokdesktopcommunity.desktop"
}
